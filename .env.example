# ============================================================
# Rhythm · переменные окружения (веб-клиент)
# Скопируйте в .env и заполните. .env НЕ коммитится.
#
# Без этих ключей приложение работает в демо-режиме (localStorage):
# это нормальный фолбэк для разработки и CI без секретов (Фаза 1.5).
# ============================================================

# URL проекта Supabase: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Публичный anon-ключ: Project Settings → API → anon public
# (безопасен для клиента: доступ ограничивает RLS, не сервисный ключ!)
VITE_SUPABASE_ANON_KEY=
